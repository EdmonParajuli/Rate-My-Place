# Database: development
DB_HOST=your-db-host
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=your-db-name
DB_DIALECT=your-db-dialect
DB_PORT=your-db-port

#APP
PORT=your-app-port-backend
PASSWORD_HASH_CONSTANT=your-app-hash-password-constant

#AUTH
JWT_ACCESS_SECRET=your-jwt-access-secret
JWT_ACCESS_EXPIRES_IN=your-jwt-access-expiry
JWT_REFRESH_SECRET=your-jwt-refresh-secret
JWT_REFRESH_EXPIRES_IN=your-jwt-refresh-expiry

#CLOUDINARY (Phase 8 media uploads - signed upload URLs, see docs/specs/phase-8-media-plumbing.md)
CLOUDINARY_NAME=your-cloudinary-cloud-name
API_KEY=your-cloudinary-api-key
API_SECRET=your-cloudinary-api-secret