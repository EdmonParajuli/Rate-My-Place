# Integration test DB (docs/06-quality-and-ops.md's "real Postgres, not mocks"
# recommendation for repository/integration tests) - a separate database from
# dev's, never the dev DB itself. Copy this to .env.test and fill in real
# values; .env.test is gitignored like .env.
#
# Defaults below match docker-compose.yml's postgres-test service exactly -
# `docker compose up -d` then copy this file as-is if you're using that. If
# you're pointing at a different local Postgres instead (e.g. no Docker
# available - see docs/specs/phase-9-integration-tests.md), just point these
# at a test-only database on it; never point DB_NAME here at the real dev DB.
DB_HOST=localhost
DB_USER=test_user
DB_PASSWORD=test_password
DB_NAME=rate_my_place_test
DB_DIALECT=postgres
DB_PORT=5433

# Everything below just needs to satisfy src/config/index.ts's mustExist()
# guards on import - integration tests exercise repositories against the real
# test DB above, not JWT signing or real Cloudinary uploads, so these are
# harmless dummy values (same convention as tests/setupEnv.ts's unit tests).
PORT=4000
PASSWORD_HASH_CONSTANT=4
JWT_ACCESS_SECRET=test-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=test-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d
CLOUDINARY_NAME=test-cloud
API_KEY=test-key
API_SECRET=test-secret
