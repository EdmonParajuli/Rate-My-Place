{
  "name": "rate-my-place",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start:watch": "nodemon dist/server.js",
    "start:dev": "nodemon --exec ts-node --type-check src/server.ts",
    "start:transpile": "nodemon --exec ts-node --transpileOnly src/server.ts",
    "start": "node dist/server.js",
    "clean": "rm -rf ./dist",
    "db:migrate": "ts-node node_modules/.bin/sequelize-cli db:migrate",
    "db:migrate:undo": "ts-node node_modules/.bin/sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "ts-node node_modules/.bin/sequelize-cli db:migrate:undo:all",
    "db:seed": "ts-node node_modules/.bin/sequelize-cli db:seed:all",
    "db:seed:undo": "ts-node node_modules/.bin/sequelize-cli db:seed:undo:all",
    "db:migrate:test": "NODE_ENV=test ts-node node_modules/.bin/sequelize-cli db:migrate",
    "db:migrate:test:undo:all": "NODE_ENV=test ts-node node_modules/.bin/sequelize-cli db:migrate:undo:all",
    "test": "jest",
    "pretest:integration": "npm run db:migrate:test",
    "test:integration": "jest --config jest.integration.config.js --runInBand --forceExit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@apollo/server": "^4.13.0",
    "@apollo/subgraph": "^2.13.3",
    "@joi/date": "^2.1.1",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.1",
    "express-rate-limit": "^8.6.2",
    "graphql": "^16.13.2",
    "graphql-tag": "^2.12.6",
    "joi": "^18.1.2",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^4.17.43",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "@types/node-cron": "^3.0.11",
    "eslint": "^9.39.4",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.3",
    "sequelize-cli": "^6.6.5",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
